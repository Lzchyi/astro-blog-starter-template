---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import frame from '../assets/iphone-frame.png';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const { src, alt, class: className, eager = false, sizes = '280px' } = Astro.props;
---
<div class:list={['phone', className]}>
  <Image class="phone-screen" src={src} alt={alt} width={760} widths={[380, 570, 760]} sizes={sizes} format="webp" quality={88} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  <Image class="phone-bezel" src={frame} alt="" aria-hidden="true" width={900} widths={[450, 675, 900]} sizes={sizes} format="webp" quality={90} loading={eager ? 'eager' : 'lazy'} />
</div>
