---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page Not Found · ShotMark" description="This page is not here. Head back to ShotMark or find help in Support." canonicalPath="/404.html">
  <main id="main-content" class="document-page wrap">
    <header class="page-intro">
      <p class="eyebrow">404</p>
      <h1>This one got away.</h1>
      <p class="lede">The page you are looking for may have moved. There is still plenty worth keeping.</p>
      <p><a class="text-link" href="/">Back to ShotMark <span aria-hidden="true">→</span></a></p>
      <p><a href="/support/">Get support</a></p>
    </header>
  </main>
</SiteLayout>
