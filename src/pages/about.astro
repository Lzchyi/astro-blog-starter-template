---
import SiteLayout from '../layouts/SiteLayout.astro';

const apps = [
  { name: 'Still13', category: 'A quiet card game', description: 'A calm take on pyramid solitaire, with room to think.', href: 'https://www.zhenchyi.com/still13/' },
  { name: 'IsoPack', category: 'A lighter way to pack', description: 'Practical packing lists to help you prepare for your next trip.', href: 'https://www.zhenchyi.com/isopack/' },
  { name: 'RankHalo', category: 'For fellow app makers', description: 'A focused way to follow App Store rankings across markets.', href: 'https://www.zhenchyi.com/rankhalo/' },
];
---

<SiteLayout title="About ShotMark & its developer" description="ShotMark is an independent app by Zhen Chyi Lee, built to keep screenshots and their context together. Meet the developer and explore more apps." canonicalPath="/about/">
  <main id="main-content" class="document-page wrap">
    <header class="page-intro">
      <p class="eyebrow">About ShotMark</p>
      <h1>A small app.<br />A useful little habit.</h1>
      <p class="lede">Made by Zhen Chyi Lee, with a simple idea: a screenshot is more useful when you remember why you saved it.</p>
    </header>

    <div class="prose">
      <section aria-labelledby="idea-title">
        <h2 id="idea-title">Keep the reason close.</h2>
        <p>A place to visit. A detail to check. Something worth coming back to. ShotMark brings the screenshot and a little context together, so the useful part doesn’t disappear into your photo library.</p>
        <p>It’s an independent app for iPhone, iPad, and Mac. The focus stays on quick capture, readable cards, and finding what matters without a complicated workspace.</p>
      </section>

      <section class="section" aria-labelledby="developer-title">
        <p class="eyebrow">Behind the app</p>
        <h2 id="developer-title">Hello from Zhen Chyi.</h2>
        <p>ShotMark is part of Zhen Chyi Apps, a collection of small, focused apps for everyday use.</p>
        <p>Have an idea, a question, or something that could work better? <a href="/support/">Get in touch</a>. You can also follow what has shipped in the <a href="/changelog/">Changelog</a>.</p>
        <a class="text-link" href="https://www.zhenchyi.com/">Visit Zhen Chyi Apps <span aria-hidden="true">↗</span></a>
      </section>

      <section class="section" aria-labelledby="more-apps-title">
        <p class="eyebrow">More by the developer</p>
        <h2 id="more-apps-title">Something else for your day.</h2>
        <div class="other-apps">
          {apps.map(app => (
            <a class="other-app" href={app.href}>
              <div><p class="app-category">{app.category}</p><h3>{app.name}</h3><p>{app.description}</p></div>
              <span class="app-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
</SiteLayout>

<style>
  .other-apps { margin-top: 24px; }
  .prose .other-app { display: flex; align-items: center; justify-content: space-between; gap: 25px; padding: 24px 0; border-top: 1px solid var(--line); color: inherit; text-decoration: none; }
  .other-app:last-child { border-bottom: 1px solid var(--line); }
  .other-app .app-category { margin: 0 0 3px; font-size: 12px; }
  .other-app h3 { margin: 0 0 5px; font-size: 23px; letter-spacing: -.03em; }
  .other-app p { margin: 0; font-size: 15px; }
  .app-arrow { color: var(--purple); font-size: 23px; transition: transform .2s; }
  .other-app:hover .app-arrow { transform: translate(2px, -2px); }
  .other-app:hover h3 { color: var(--purple); }
  @media (prefers-reduced-motion: reduce) { .app-arrow { transition: none; } }
</style>
